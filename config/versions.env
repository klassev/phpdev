# Версии компонентов phpdev (единственный источник правды для установщика)
# После изменений: перезапустите нужные команды setup-dev-env.sh

# PHP через apt (ondrej/php). Пробел-разделённый список.
PHP_SUPPORTED="8.1 8.2 8.3 8.4 8.5"
PHP_LEGACY="7.3 7.4"
PHP_DEFAULT="8.4"

# Инструменты
GO_VERSION="1.26.1"
MKCERT_VERSION="v1.4.4"
NVM_VERSION="v0.40.3"

# Перехват почты: mailpit (рекомендуется) | mailhog (legacy)
MAIL_CATCHER="mailpit"
MAILPIT_VERSION="v1.24.1"

# Desktop-приложения (фиксированные релизы; при желании обновите вручную)
OBSIDIAN_VERSION="1.5.12"
PHPSTORM_VERSION="2024.3.1.1"
# Полный URL можно переопределить; иначе собирается из PHPSTORM_VERSION
# PHPSTORM_URL="https://download.jetbrains.com/webide/PhpStorm-2024.3.1.1.tar.gz"
